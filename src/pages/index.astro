---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import About from "../components/About.astro";
import FeaturedWork from "../components/home/FeaturedWork.astro";
import ProcessStack from "../components/home/ProcessStack.astro";
import ScrollPath from "../components/home/ScrollPath.astro";
import ScrollBird from "../components/home/ScrollBird.astro";
import LiquidEdge from "../components/LiquidEdge.astro";
import "../styles/home.css";
---

<BaseLayout title="Indi Watté | Creative Portfolio" bodyClass="home-page">
	<main id="top">
		<Hero />

		<!-- Pulled up over the pinned hero (see heroScroll.ts), with a liquid top edge -->
		<div id="story" class="story">
			<!-- Liquid, organic edge that slides over the hero -->
			<LiquidEdge seed={7} color="var(--home-bg)" />
			<!-- The sun's light shining through the white layer, fixed to the bottom of the
			     screen so it stays with you down the whole page (heroScroll.ts) -->
			<div class="sun-glow" data-sun-glow aria-hidden="true"></div>

			<!-- The scroll line runs through About and stops right next to the "Featured work" heading -->
			<div class="about-wrap">
				<ScrollPath name="about" endAt="#work h2" />
				<About />
			</div>
			<!-- How I work: a stack that builds itself while you scroll -->
			<ProcessStack />
			<FeaturedWork />
		</div>

		<ScrollBird />
	</main>

	<!-- …and starts again in the footer, where the bird lands right after "together?" -->
	<ScrollPath
		slot="footer"
		name="footer"
		variant="landing"
		endAt="[data-footer-flower]"
		color="var(--home-pink)"
		background="var(--footer-bg)"
	/>

	<script>
		import "../scripts/home";
	</script>
</BaseLayout>

<style>
	/* Pulled up over the pinned hero (see heroScroll.ts), so it slides over it */
	.story {
		position: relative;
		z-index: 30;
		margin-top: calc(-100vh - 3rem);
		background: var(--home-bg);
	}

	/* Warm light from the sun below the screen, shining up through the white layer. Fixed,
	   so it stays in place while the page scrolls; multiply tints the white without
	   washing out text or images. Fades in once the layer covers the sky (heroScroll.ts);
	   the footer (z-index 40) slides over it. */
	.sun-glow {
		position: fixed;
		left: 50%;
		bottom: 0;
		z-index: 11; /* above the LiquidEdge (10) */
		width: min(140vw, 110rem);
		height: 75vh;
		translate: -50% 50%;
		background: radial-gradient(ellipse 50% 50% at 50% 50%, rgba(255, 186, 100, 0.6), rgba(255, 160, 130, 0.25) 45%, rgba(255, 160, 130, 0) 72%);
		mix-blend-mode: multiply;
		opacity: 0;
		pointer-events: none;
	}

	:global(html[data-theme="dark"]) .sun-glow {
		mix-blend-mode: screen;
		filter: brightness(0.5);
	}

	/* Without the scroll animation the glow simply stays on */
	@media (prefers-reduced-motion: reduce) {
		.sun-glow {
			opacity: 1;
		}
	}

	/* Holds the About scroll line (ScrollPath covers this box) */
	.about-wrap {
		position: relative;
	}
</style>
