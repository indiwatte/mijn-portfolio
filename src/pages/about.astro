---
import BaseLayout from "../layouts/BaseLayout.astro";
import LiquidEdge from "../components/LiquidEdge.astro";
import Resume from "../components/Resume.astro";
import Creature from "../components/creatures/Creature.astro";
import "../styles/home.css";

// Experience layer (peach).
// The first item of the first group starts open. A group without items is left out.
interface ExperienceItem {
	place: string;
	role: string;
	period: string;
	summary: string;
	highlights: string[];
	href?: string;
	/** Optional photos (one or two), shown next to the text when the item is open. */
	images?: { src: string; alt: string; caption?: string }[];
}

const experience: { title: string; items: ExperienceItem[] }[] = [
	{
		title: "Experience",
		// Jobs, freelance and volunteer work, newest first. Copy the example below, fill
		// it in and remove the // to show it (even work outside design counts: it shows
		// you're reliable, work in a team and can handle pressure).
		items: [
			{
				place: "Restaurant worker",
				role: "Student job · often shift lead",
				period: "3 + years",
				images: [
					{
						src: "/images/work-dessert.webp",
						alt: "A plated chocolate dessert with strawberries, made at work",
						caption: "Making desserts at work",
					},
					{
						src: "/images/work-restaurant.webp",
						alt: "Three members of the restaurant team in Day of the Dead face paint and flower crowns, on the colourful staircase",
						caption: "Día de Muertos with the team",
					},
				],
				summary:
					"I haven’t worked in the design industry yet, and that’s exactly why I’m so excited for this internship. I can’t wait to bring my skills from the classroom into real projects, with real clients and a real impact. For three years I've been working in a restaurant next to my studies, where I often lead the shifts. Work smart, not hard: that's my motto, in the kitchen as much as in design.",
				highlights: [
					"Leading the team during busy services and keeping everyone on the same page.",
					"Always looking for ways to make the work more efficient and easier for everyone, even in the restaurant.",
					"I love working in a team: it's where the best ideas and the smoothest services come from.",
				],
			},
		],
	},
	{
		title: "Skills",
		// What I can do; "period" shows how big a part of my work it is.
		// Items with an href get a link to a project that shows it.
		items: [
			{
				place: "Frontend development",
				role: "HTML, CSS, JavaScript",
				period: "Main focus",
				summary:
					"Most of my development work happens in the frontend: turning designs into responsive, animated websites that feel good to use.",
				highlights: [
					"Responsive layouts and interactions that work from phone to desktop.",
					"Scroll and motion animations, like the ones on this portfolio (built with Astro and GSAP).",
				],
			},
			{
				place: "Brand identity & logos",
				role: "Logo design, visual identity, packaging",
				period: "Core skill",
				summary:
					"I design logos and complete brand identities: colours, typography, illustrations and how it all comes together on packaging and screens.",
				highlights: [
					"Miles & Meals: brand strategy, visual identity, packaging and digital design for a street-food meal kit.",
				],
				href: "/projects/miles-meals",
			},
			{
				place: "Visual storytelling on the web",
				role: "Concept, art direction, web design",
				period: "Core skill",
				summary:
					"I like to bring stories visually alive in websites, so visitors don't just read the story but experience it.",
				highlights: [
					"Sounds Like Antwerp: a website that turns live city data into music and visuals, for Visit Antwerp.",
				],
				href: "/projects/sounds-like-antwerp",
			},
			{
				place: "UI design in Figma",
				role: "Wireframes, UI design, prototypes",
				period: "Core skill",
				summary:
					"I design interfaces in Figma, from the first wireframes to detailed screens and clickable prototypes.",
				highlights: [],
			},
			{
				place: "Backend development",
				role: "The basics",
				period: "Some experience",
				summary:
					"I have done a bit of backend work as well, enough to understand how the frontend connects to data and to build simple features end to end.",
				highlights: [],
			},
		],
	},
	{
		title: "Education",
		items: [
			{
				place: "Devine, Howest Kortrijk",
				role: "Bachelor Digital Design & Development · in progress",
				period: "2024 – 2027 (expected)",
				summary:
					"My bachelor is still ongoing. It's the programme where design and code come together: branding, web design, UI/UX research and building interactive experiences.",
				highlights: [],
			},
			{
				place: "Tekenacademie Zottegem",
				role: "Digital atelier (diploma)",
				period: "Until 2024",
				summary:
					"In my free time, next to high school, I followed the digital atelier at the drawing academy, where my drawing and painting moved to the screen.",
				highlights: [],
			},
			{
				place: "KAZ Zottegem",
				role: "Latin – Mathematics",
				period: "2018 – 2024",
				summary:
					"Secondary school in Latin and mathematics, while I kept exploring art through drawing and painting.",
				highlights: [],
			},
		],
	},
];
---

<BaseLayout
	title="About | Indi Watté"
	description="About Indi Watté: from drawing and painting to digital design. Bachelor Digital Design & Development at Devine, looking for an internship."
	bodyClass="home-page"
>
	<main class="about-page">
		<!-- Stays put while the peach experience layer slides over it (layerReveal.ts) -->
		<div class="about-intro" data-layer-under>
			<!-- Big title on its own, shrinks as you scroll (heroTitle.ts) -->
			<section class="about-hero" data-about-hero>
				<div class="about-hero-stage">
					<h1 class="about-title" data-about-title>
						<span class="about-title-line"><span>Hi, I'm</span></span>
						<span class="about-title-line"
							><span><mark class="marker about-mark" data-about-mark>Indi.</mark></span></span
						>
					</h1>
				</div>
			</section>

			<div class="about-grid">
				<!-- ============ TEXT ============ -->
				<section class="about-text">
					<p class="about-kicker">About me</p>

					<p class="about-lead">
						I started out drawing and painting, then found digital
						design, where I could combine that artistic side with
						code.
					</p>
					<p>
						Today I build stories and the websites they live on:
						from brand identity to the frontend that brings it to
						life. I look for the story first, then give it a shape
						people actually want to click or keep.
					</p>
					<p>
						Offline, I recharge by hiking mountains, swimming,
						dancing, and experimenting with fresh ingredients in the
						kitchen. For me, living a healthy and happy life beyond
						the screen is the best interactive experience overall.
					</p>

					<div class="about-actions">
								<a href="/projects" class="about-button"
									>See my work</a
								>
								<a
									href="mailto:indi.watte1@gmail.com"
									class="about-button about-button--ghost"
									>Say hi</a
								>
								<a
									href="/files/resume.pdf"
									class="about-button about-button--ghost"
									download="Indi-Watte-resume.pdf">Resume ↓</a
								>
								<a
									href="https://github.com/indiwatte"
									class="about-button about-button--ghost"
									target="_blank"
									rel="noopener noreferrer">GitHub ↗</a
								>
							</div>


				</section>

				<!-- ============ PHOTO BOARD (drag the photos around) ============ -->
				<section
					class="about-board"
					data-photo-board
					aria-label="Photos"
				>
					<figure
						class="about-photo about-photo-big"
						data-photo-big
						data-rotate="-2"
					>
						<img
							src="/images/photo-me.jpg"
							alt="Portrait of Indi"
							draggable="false"
							loading="lazy"
							decoding="async"
						/>
						<!-- the rainbow clips the photo at its top edge, eyes peeking over -->
						<Creature name="rainbow" index={0} class="photo-clip photo-clip--rainbow" />
					</figure>
					<figure
						class="about-photo about-photo-small"
						data-photo-small
						data-rotate="5"
					>
						<img
							src="/images/dessert.jpg"
							alt="Selfie of Indi smiling at sunset"
							draggable="false"
							loading="lazy"
							decoding="async"
						/>
						<!-- the eye character holds the photo by its corner -->
						<Creature name="cyclops" index={2} class="photo-clip photo-clip--cyclops" />
					</figure>
					<div class="about-cast" aria-hidden="true">
						<Creature
							name="cloud"
							index={1}
							class="cast-creature"
							style="--x: 64%; --y: 80%; --size: 7rem; --r: 6deg"
						/>
					</div>
			
				</section>
			</div>
		</div>

		<!-- ============ EXPERIENCE: PEACH LAYER ============ -->
		<!-- data-footer-overlap: this layer stays pinned while the footer slides over it -->
		<section class="about-experience" data-layer-over data-footer-overlap>
			<LiquidEdge seed={41} color="var(--about-layer-top)" />

			<div class="experience-inner">
				<p class="experience-intro">
					Currently studying Digital Design & Development at Devine
					and{" "}
					<strong
						>looking for an internship from February to May 2027</strong
					>{" "}
					(second semester).{" "}
					<a href="mailto:indi.watte1@gmail.com">Let's talk →</a>
				</p>

				{
					experience.filter((group) => group.items.length).map((group, g) => (
						<div class="experience-group">
							<h2 class="experience-heading">{group.title}</h2>

							<div class="experience-list">
								{group.items.map((item, i) => (
									<details
										class="experience-item"
										open={g === 0 && i === 0}
									>
										<summary>
											<span class="experience-head">
												<span class="experience-place">
													{item.place}
												</span>
												<span class="experience-role">
													{item.role}
												</span>
											</span>
											<span class="experience-period">
												{item.period}
											</span>
											<span
												class="experience-toggle"
												aria-hidden="true"
											/>
										</summary>

										<div
											class:list={[
												"experience-body",
												{ "has-image": item.images?.length },
											]}
										>
											<div class="experience-text">
											<p>{item.summary}</p>
											{item.highlights.length > 0 && (
												<ul>
													{item.highlights.map(
														(highlight) => (
															<li>{highlight}</li>
														),
													)}
												</ul>
											)}
											{item.href && (
												<a
													href={item.href}
													class="experience-link"
												>
													View the project →
												</a>
											)}
											</div>
											{item.images?.length && (
												<div class="experience-photos">
													{item.images.map((image) => (
														<figure class="experience-photo">
															<img
																src={image.src}
																alt={image.alt}
																loading="lazy"
																decoding="async"
															/>
															{image.caption && (
																<figcaption>{image.caption}</figcaption>
															)}
														</figure>
													))}
												</div>
											)}
										</div>
									</details>
								))}
							</div>
						</div>
					))
				}

				<!-- Resume: download button with a preview of the PDF -->
				<div class="experience-group about-resume">
					<h2 class="experience-heading">Resume</h2>
					<Resume size="22rem" />
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	import "../scripts/about/heroTitle";
	import "../scripts/about/photos";
	import "../scripts/about/layerReveal";
	import "../scripts/about/experienceHeadings";
</script>

<style>
	.about-page {
		color: var(--home-text);
	}

	.about-intro {
		position: relative;
		z-index: 1;
		min-height: 100vh;
		box-sizing: border-box;
		/* bottom: as tall as the experience layer's wavy edge (LiquidEdge: 20.8vw, min 130px,
		   92% of it above the layer), so it never covers the buttons */
		padding: 0 clamp(1.25rem, 4vw, 3.5rem)
			calc(max(130px, 20.8vw) * 0.92 + 1.5rem);
		background: var(--home-bg);
	}

	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(3rem, 8vw, 5rem);
		max-width: 1440px;
		margin-inline: auto;
	}

	/* ============ TEXT ============ */
	.about-text {
		max-width: 44rem;
	}

	.about-kicker {
		margin: 0 0 0.75rem;
		font-family: var(--display-font);
		font-style: italic;
		font-size: 1.2rem;
		color: var(--home-accent);
	}

	/* ============ HERO: big title that shrinks on scroll (heroTitle.ts) ============ */
	.about-hero {
		position: relative;
		height: 160svh; /* the scroll distance the title takes to shrink */
	}

	.about-hero-stage {
		position: sticky;
		top: 0;
		display: grid;
		place-items: center;
		height: 100svh;
	}

	.about-title {
		margin: 0;
		font-family: var(--heading-font);
		font-size: clamp(3.5rem, 13vw, 13rem);
		font-weight: 400;
		line-height: 0.9;
		letter-spacing: -0.01em;
		text-align: center;
		text-transform: uppercase;
		color: var(--home-text);
		transform-origin: 50% 50%;
		will-change: transform;
	}

	/* each line sits in a mask, so it can rise into view */
	.about-title-line {
		display: block;
		overflow: hidden;
		padding: 0.04em 0 0.1em;
	}

	.about-title-line > span {
		display: inline-block;
	}

	/* My name: same letters as the rest of the title, with the big marker highlight drawn
	   over it once the title has risen in (heroTitle.ts; the stroke itself: global.css) */
	.about-title .about-mark {
		padding: 0 0.12em;
		background-position: 0 62%;
	}

	@media (prefers-reduced-motion: reduce) {
		.about-hero {
			height: auto;
		}

		.about-hero-stage {
			height: auto;
			padding-block: 22svh 10svh;
		}
	}

	.about-text p {
		margin: 0 0 1.1em;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.8;
		color: var(--home-muted);
	}

	.about-text .about-lead {
		font-size: clamp(1.15rem, 1.6vw, 1.35rem);
		font-weight: 400;
		line-height: 1.55;
		color: var(--home-text);
	}

	.about-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}

	.about-button {
		display: inline-block;
		padding: 0.7rem 1.5rem;
		border: 1px solid var(--home-blue);
		border-radius: var(--radius-pill);
		background: var(--home-blue); /* primary: navy + off-white */
		color: #fff;
		font-size: 0.85rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			background 200ms ease,
			border-color 200ms ease,
			color 200ms ease;
	}

	.about-button:hover {
		border-color: var(--home-text);
		background: var(--home-text);
		color: var(--home-bg);
	}

	.about-button--ghost {
		border-color: var(--home-pink);
		background: var(--home-pink); /* secondary: pink + maroon */
		color: var(--home-ink);
	}

	.about-button--ghost:hover {
		border-color: var(--home-sun);
		background: var(--home-sun);
		color: var(--home-ink);
	}

	/* ============ PHOTO BOARD ============ */
	.about-board {
		order: -1; /* on phones the photos come before the text */
		position: relative;
		height: clamp(34rem, 72vh, 46rem);
		/* the big photo slides in from beyond the board's side; the top stays open for the rainbow clip */
		overflow-x: clip;
		overflow-y: visible;
		isolation: isolate; /* dragged photos stack above each other, never above the header */
		touch-action: pan-y; /* the page still scrolls when you swipe next to a photo */
	}

	/* no overflow clipping: the creature clips stick out over the edges */
	.about-photo {
		position: absolute;
		margin: 0;
	
	
		user-select: none;
		will-change: transform;
	}

	.about-photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	/* the small photo sits behind the big one until it comes out */
	.about-photo-big {
		left: 6%;
		top: 6%;
		width: 60%;
		aspect-ratio: 4 / 5;
		z-index: 2;
	}

	.about-photo-small {
		left: 58%;
		top: 50%;
		width: 36%;
		aspect-ratio: 1;
		z-index: 1;
	}

	/* Creatures used as clips: they sit on a photo's edge and move along when it's dragged.
	   Placed with left/top/margin, because their float animation uses translate. */
	.about-photo :global(.photo-clip) {
		position: absolute;
		z-index: 1;
		filter: drop-shadow(0 6px 8px rgba(23, 21, 58, 0.25));
	}

	/* the arch straddles the top edge, centred: its feet and eyes just over the photo */
	.about-photo :global(.photo-clip--rainbow) {
		left: 50%;
		top: 0;
		width: clamp(6rem, 11vw, 9.5rem);
		margin: calc(clamp(6rem, 11vw, 9.5rem) * -0.6) 0 0 calc(clamp(6rem, 11vw, 9.5rem) * -0.5);
	}

	/* on the top right corner, half on the photo, tilted like it's holding on */
	.about-photo :global(.photo-clip--cyclops) {
		right: 0;
		top: 0;
		width: clamp(4rem, 7vw, 6rem);
		margin: calc(clamp(4rem, 7vw, 6rem) * -0.42) calc(clamp(4rem, 7vw, 6rem) * -0.36) 0 0;
		rotate: 14deg;
	}

	/* Characters sit under the photos, on the left */
	.about-cast {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.about-cast :global(.cast-creature) {
		position: absolute;
		left: var(--x);
		top: var(--y);
		width: var(--size);
		rotate: var(--r);
	}

	@media (max-width: 767px) {
		.about-cast :global(.cast-creature) {
			width: calc(var(--size) * 0.6);
		}
	}

	.about-hint {
		position: absolute;
		right: 0;
		bottom: 0;
		z-index: -1; /* the photos slide over it */
		margin: 0;
		font-family: var(--display-font);
		font-style: italic;
		font-size: 0.95rem;
		color: var(--home-accent);
		pointer-events: none;
	}

	/* ============ EXPERIENCE: PEACH LAYER ============ */
	.about-experience {
		position: relative;
		z-index: 2; /* slides over the pinned intro */
		min-height: 100svh; /* covers the intro completely */
		box-sizing: border-box;
		padding: clamp(4rem, 8vw, 7rem) clamp(1.25rem, 4vw, 3.5rem)
			clamp(7rem, 12vw, 10rem);
		/* not flat: the soft orange of the sun and the footer flower, warming up towards the
		   bottom, no grain (clean, modern). The wavy edge on top uses the same top colour. */
		background: linear-gradient(
			180deg,
			var(--about-layer-top) 0%,
			var(--about-layer-mid) 60%,
			var(--about-layer-bottom) 100%
		);
		color: var(--home-text);
	}

	:global(:root) {
		--about-layer-top: #ffd2ad;
		--about-layer-mid: #ffbf8f;
		--about-layer-bottom: #ffad86;
	}

	/* Dark mode: a warm night, plum melting into a deep ember */
	:global(html[data-theme="dark"]) {
		--about-layer-top: #2a1838;
		--about-layer-mid: #34183a;
		--about-layer-bottom: #43203a;
	}

	.experience-inner {
		display: grid;
		gap: clamp(4rem, 8vw, 7rem);
		max-width: 1440px;
		margin-inline: auto;
	}

	.experience-group {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
	}

	/* "Looking for an internship" line above the lists */
	.experience-intro {
		max-width: 48rem;
		margin: 0;
		font-size: clamp(1.3rem, 2.4vw, 2.1rem);
		font-weight: 400;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	.experience-intro strong {
		font-weight: 600;
	}

	.experience-intro a {
		display: inline-block;
		font-weight: 600;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.2em;
		transition: color 200ms ease;
	}

	.experience-intro a:hover {
		color: var(--home-accent);
	}

	/* Big and heavy, so the groups stand out. The serif has a single weight (no bold), so a thin
	   stroke in the text's own colour thickens the letters instead of a faux bold. */
	.experience-heading {
		margin: 0;
		font-family: var(--heading-font);
		font-size: clamp(3.2rem, 7vw, 7rem);
		font-weight: 400;
		line-height: 0.9;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: var(--home-text);
		-webkit-text-stroke: 0.028em currentColor;
		paint-order: stroke fill;
		transition: color 500ms ease;
	}

	/* The group you are reading lights up (experienceHeadings.ts) */
	.experience-heading:global(.is-active) {
		color: var(--home-accent);
	}

	.experience-list {
		border-top: 1px solid color-mix(in srgb, var(--home-text) 25%, transparent);
		interpolate-size: allow-keywords; /* lets the items animate open where supported */
	}

	.experience-item {
		border-bottom: 1px solid color-mix(in srgb, var(--home-text) 25%, transparent);
	}

	.experience-item summary {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto auto;
		align-items: center;
		gap: 1rem clamp(1rem, 3vw, 2.5rem);
		padding: clamp(1.25rem, 2.5vw, 2rem) 0;
		list-style: none;
	}

	.experience-item summary::-webkit-details-marker {
		display: none;
	}

	.experience-item summary:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}

	.experience-head {
		display: grid;
		gap: 0.3rem;
	}

	.experience-place {
		font-size: clamp(1.3rem, 2.4vw, 2rem);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.01em;
	}

	.experience-role {
		font-size: clamp(0.9rem, 1.2vw, 1.05rem);
