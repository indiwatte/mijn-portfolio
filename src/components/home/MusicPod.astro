---
// Small "vinyl" player in the hero (behaviour: src/scripts/home/musicPod.ts).
// Ids and .pod-vinyl are used by that script.
---

<div id="music-pod" class="pod">
	<audio id="pod-audio" src="/audio/audioplay.mp3" preload="none"></audio>

	<div class="pod-vinyl"><div class="pod-label"></div></div>

	<div class="pod-info">
		<p class="pod-text">While you're here, play some music if you like.</p>
		<div class="pod-time">
			<span>0:03</span>
			<div class="pod-track">
				<div id="pod-progress" class="pod-progress" style="transform: scaleX(0.25)"></div>
			</div>
			<span>1:23</span>
		</div>
	</div>

	<div class="pod-vinyl"><div class="pod-label"></div></div>

	<button id="pod-play" class="pod-play" aria-label="Play">▶</button>
</div>

<style>
	.pod {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1rem;
		width: 100%;
		max-width: 24rem;
		margin-top: 2.5rem;
		padding: 0.75rem 1rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 28px;
		background: rgba(255, 255, 255, 0.9);
		color: #000;
		box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
	}

	/* ============ VINYL RECORDS ============ */
	.pod-vinyl {
		position: relative;
		flex-shrink: 0;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 50%;
		background: radial-gradient(circle at center, #4a4a4a 0%, #161616 60%, #000 100%);
	}

	.pod-label {
		position: absolute;
		inset: 0;
		width: 0.75rem;
		height: 0.75rem;
		margin: auto;
		border-radius: 50%;
		background: var(--home-sun);
	}

	/* ============ TEXT + PROGRESS ============ */
	.pod-info {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.375rem;
	}

	.pod-text {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 600;
		color: rgba(0, 0, 0, 0.8);
	}

	.pod-time {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 10px;
		font-weight: 500;
		color: rgba(0, 0, 0, 0.5);
	}

	.pod-track {
		position: relative;
		flex: 1;
		height: 0.25rem;
		overflow: hidden;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.15);
	}

	.pod-progress {
		position: absolute;
		inset: 0;
		border-radius: 999px;
		background: var(--home-pink);
		transform-origin: left;
	}

	/* ============ PLAY BUTTON ============ */
	.pod-play {
		position: absolute;
		bottom: -1rem;
		left: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 0;
		border-radius: 50%;
		background: #000;
		color: #fff;
		font-size: 0.875rem;
		transform: translateX(-50%);
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
	}
</style>
