---
import HeroCreatures from "./HeroCreatures.astro";
// The ids (#hero, #hero-line-static, #hero-word, …) are used by src/scripts/home/.

// Dark mode: a fixed field of stars (the same on every visit), faded in by CSS
const STARS = (() => {
	let seed = 7;
	const random = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
	return Array.from({ length: 90 }, () => ({
		x: (random() * 100).toFixed(2),
		y: (random() * 78).toFixed(2),
		size: (1 + random() * 2.4).toFixed(1),
		duration: (2.5 + random() * 3.5).toFixed(1),
		delay: (-random() * 6).toFixed(1),
	}));
})();
---

<section id="hero" class="hero" data-header-dark>
	<!-- Flowing, watery sky (WebGL, heroWater.ts); the CSS gradient below is the fallback -->
	<canvas class="hero-water" data-hero-water aria-hidden="true"></canvas>
	<!-- Dark mode: stars in the sky (CSS shows them only in dark mode) -->
	<div class="hero-stars" aria-hidden="true">
		{
			STARS.map((star) => (
				<span
					class="star"
					style={`left: ${star.x}%; top: ${star.y}%; --size: ${star.size}px; --duration: ${star.duration}s; --delay: ${star.delay}s`}
				></span>
			))
		}
	</div>
	<!-- The sun: peeks above the white layer at the bottom and stays in place while the
	     layer slides over it. Its glow keeps shining through the white layer (index.astro). -->
	<div class="hero-sun" data-hero-sun aria-hidden="true"></div>
	<!-- Grain over the gradient sky -->
	<div class="hero-grain" aria-hidden="true"></div>

	<!-- Little creatures whose eyes follow the mouse -->
	<HeroCreatures />

	<div class="hero-content">
		<p class="home-eyebrow header-eyebrow">
			Hi, I'm Indi Watté, a<!-- the bee (ScrollBird) starts right after this line -->
			<span class="bee-anchor" data-bee-start>
				<!-- What the bee is about: shown while it waits in the hero, gone once it flies -->
				<span class="bee-bubble" data-bee-bubble aria-hidden="true"
					><span class="bee-bubble-pop">Busy bee at work ☕</span
					></span
				>
			</span>
		</p>

		<!-- Centred title. Pills inside the sentence: one of my mockups between "Designer" and
		     "who", and a photo of me in the open space left of the rotating word -->
		<h1 class="hero-title">
			<span class="hero-line hero-line--static">
				<span id="hero-line-static"></span>
				<span class="hero-pill hero-pill--work">
					<img
						src="/images/hero-mockup.webp"
						width="480"
						height="476"
						alt=""
						fetchpriority="high"
					/>
				</span>
				<span id="hero-line-static-end"></span>
			</span>
			<span class="hero-line hero-line--word">
				<span class="hero-pill hero-pill--me">
					<img
						src="/images/selfie-pill.webp"
						width="520"
						height="400"
						alt="Indi Watté"
						fetchpriority="high"
					/>
				</span>
				<span id="hero-line-dynamic" class="hero-word-slot">
					<span id="hero-word" class="hero-word"></span>
				</span>
			</span>
		</h1>

		<p class="hero-subtitle">I build web experiences to remember.</p>
	</div>
</section>

<style>
	/* ============ SECTION: GRADIENT SKY + GRAIN ============ */
	.hero {
		position: relative;
		/* fallback when WebGL is off: the same soft sky as heroWater.ts */
		background: linear-gradient(
			180deg,
			#9eadfa 0%,
			#bdc4fc 30%,
			#ded1f7 55%,
			#ffd1de 72%,
			#ffc2a8 84%,
			#fff2eb 100%
		);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100vh;
		min-height: 640px;
		overflow: hidden;
	}

	.hero-water {
		position: absolute;
		inset: 0;
		z-index: 0;
		width: 100%;
		height: 100%;
	}

	/* Dark mode: the night sky (fallback gradient; heroWater.ts draws the same mood) */
	html[data-theme="dark"] .hero {
		background: linear-gradient(
			180deg,
			#070716 0%,
			#0f0d2e 35%,
			#1f1648 62%,
			#3a1f4f 84%,
			#5a2b50 100%
		);
	}

	/* ============ STARS (dark mode only) ============ */
	.hero-stars {
		position: absolute;
		inset: 0;
		z-index: 1;
		opacity: 0;
		pointer-events: none;
		transition: opacity 800ms ease;
	}

	html[data-theme="dark"] .hero-stars {
		opacity: 1;
	}

	.star {
		position: absolute;
		width: var(--size);
		height: var(--size);
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 0 calc(var(--size) * 3) rgba(255, 255, 255, 0.8);
		animation: twinkle var(--duration) ease-in-out var(--delay) infinite;
	}

	@keyframes twinkle {
		0%,
		100% {
			opacity: 0.3;
		}
		50% {
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.star {
			animation: none;
		}
	}

	html[data-theme="dark"] .hero-sun {
		opacity: 0.45; /* a dimmer sun for the night */
	}

	/* ============ SUN ============ */
	.hero-sun {
		position: absolute;
		left: 50%;
		bottom: 2vw; /* half of it peeks above the white wave at rest */
		z-index: 1;
		width: clamp(14rem, 26vw, 26rem);
		aspect-ratio: 1;
		translate: -50% 50%;
		border-radius: 50%;
		background: radial-gradient(
			circle at 50% 45%,
			#fffbe6 0%,
			#ffe28a 28%,
			#ffb35c 58%,
			#ff8a5b 78%,
			rgba(255, 138, 91, 0) 100%
		);
		box-shadow:
			0 0 60px 20px rgba(255, 214, 140, 0.55),
			0 0 160px 80px rgba(255, 170, 120, 0.35),
			0 0 320px 160px rgba(255, 190, 170, 0.25);
		pointer-events: none;
	}

	.hero-grain {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: var(--grain);
		opacity: 0.3;
		mix-blend-mode: soft-light;
		pointer-events: none;
	}

	/* ============ BUSY BEE SPEECH BUBBLE ============ */
	.bee-anchor {
		position: relative;
		display: inline-block;
	}

	/* Outer: placed + faded on scroll (script); inner: pops in once (CSS) */
	.bee-bubble {
		position: absolute;
		left: 7.5rem;
		bottom: calc(
			1.6rem + 40px
		); /* follows the bee, lifted above the intro line */
	}

	.bee-bubble-pop {
		display: block;
		padding: 0.45rem 0.9rem;
		border-radius: 1rem 1rem 1rem 0.2rem;
		background: #fff;
		color: var(--home-text);
		font-family: var(--body-font);
		font-size: 0.8rem;
		font-weight: 600;
		white-space: nowrap;
		box-shadow: 0 10px 24px rgba(23, 21, 58, 0.2);
		transform-origin: 0 100%;
		animation: bubble-pop 0.6s 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}

	@keyframes bubble-pop {
		from {
			opacity: 0;
			scale: 0.4;
		}
	}

	@media (max-width: 767px) {
		/* Phones: no room on the right, so it sits to the left of the bee, above the intro line */
		.bee-bubble {
			left: auto;
			right: 0.4rem;
			bottom: 1.5rem;
		}

		.bee-bubble-pop {
			font-size: 0.7rem;
			border-radius: 1rem 1rem 0.2rem 1rem;
			transform-origin: 100% 100%;
		}
	}

	/* ============ TEXT: CENTRED ============ */
	.hero-content {
		position: relative;
		z-index: 10;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		max-width: 72rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
		/* sits a bit above the middle, clear of the clouds at the bottom */
		margin-bottom: 20vh;
		text-align: center;
		color: #fff;
	}

	/* "Designer who" + pills + the rotating word */
	.hero-title {
		margin: 0.25em 0 0;
		font-size: clamp(3rem, 9.5vw, 9.5rem);
		font-family: var(--title-font);
		font-style: normal;
		font-weight: 400;
		line-height: 0.9;
		letter-spacing: -0.025em;
		text-transform: uppercase;
		user-select: none;
	}

	.hero-subtitle {
		color: white;
	}


	/* The photo stays put, a little in from the left edge of "Designer who"; the word
	   starts right after it and grows to the right. width: 0 + min-width: 100% keeps
	   this line out of the title's width, so a longer word never re-centres anything. */
	.hero-line--word {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 0.14em;
		width: 0;
		min-width: 100%;
		margin-top: 0.06em;
		padding-left: 1.1em;
		box-sizing: border-box;
		color: white;
	}

	/* clips the word only while it spins (heroText.ts adds .is-spinning) */
	.hero-word-slot {
		display: inline-block;
	}

	.hero-word {
		display: inline-block;
		padding-block: 0.08em; /* room for the spinning word, without a gap */
	}

	/* "Designer [mockup] who" */
	.hero-line--static {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.14em;
	}

	/* A pill-shaped image inside the sentence, the height of the capitals */
	.hero-pill {
		flex: none;
		display: inline-block;
		height: 0.78em;
		aspect-ratio: 1.3;
		overflow: hidden;
		border-radius: 999px;
		translate: 0 -0.04em;
	}

	/* The mockup floats on a soft lilac, smaller than the pill so the laptop shows whole */
	.hero-pill--work {
		background: #ddd3f7;
	}

	.hero-pill--work img {
		object-fit: contain;
		padding: 0.06em 0.1em;
		box-sizing: border-box;
	}

	.hero-pill img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-subtitle {
		margin: clamp(0.8rem, 2vh, 1.3rem) 0 0;
		font-family: var(--body-font);
		font-size: clamp(1.05rem, 1.6vw, 1.4rem);
		font-weight: 600;
		color: white;
		border: 1px solid white;
		padding: 0.4rem 0.8rem;
		border-radius: 999px; /* ink: readable on the light sky */
	}

	/* ============ PHONES ============ */
	@media (max-width: 767px) {
		.hero {
			align-items: center;
		}

		.hero-title {
			font-size: clamp(
				2.5rem,
				12vw,
				3.8rem
			); /* "Designer who" fits the screen */
		}

		.hero-content {
			margin-bottom: 6vh;
		}
	}
</style>

<script>
	import { gsap } from "../../scripts/gsap";
	// The speech bubble fades away as soon as the bee starts flying off (first bit of scroll).
	const bubble = document.querySelector("[data-bee-bubble]");
	if (bubble) {
		gsap.fromTo(
			bubble,
			{ autoAlpha: 1, y: 0 },
			{
				autoAlpha: 0,
				y: -10,
				ease: "none",
				scrollTrigger: { start: 0, end: 120, scrub: true },
			},
		);
	}
</script>
