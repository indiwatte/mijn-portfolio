---
import MusicPod from "./MusicPod.astro";
import HeroCreatures from "./HeroCreatures.astro";
// The ids (#hero, #hero-line-static, #hero-word, …) are used by src/scripts/home/.
---

<section id="hero" class="hero">
	<!-- Grain over the gradient sky -->
	<div class="hero-grain" aria-hidden="true"></div>

	<!-- The mirror: my photo framed in a tall arch, floating on clouds -->
	<div class="hero-portal" aria-hidden="true" data-portal>
		<div class="portal-frame" data-depth="12">
			<img
				class="portal-me"
				src="/images/selfie2.jpg "
				width="1400"
				height="1867"
				alt=""
				fetchpriority="high"
			/>
		</div>
		<!-- Puffy clouds in front of the bottom of the frame, spilling over its edges -->
		<svg class="portal-clouds" viewBox="0 0 520 150" data-depth="26">
			<defs>
				<radialGradient id="cloud-shade" cx="45%" cy="30%" r="75%">
					<stop offset="0" stop-color="#ffffff" />
					<stop offset=".7" stop-color="#fbf4ff" />
					<stop offset="1" stop-color="#e9dcf7" />
				</radialGradient>
			</defs>
			<g fill="url(#cloud-shade)">
				<circle cx="70" cy="100" r="46" />
				<circle cx="140" cy="78" r="62" />
				<circle cx="225" cy="92" r="54" />
				<circle cx="300" cy="70" r="66" />
				<circle cx="380" cy="94" r="52" />
				<circle cx="450" cy="104" r="42" />
				<rect x="40" y="100" width="440" height="50" rx="25" />
			</g>
		</svg>
		<svg class="portal-sparkle portal-sparkle--1" viewBox="0 0 40 40" data-depth="34"><path d="M20 0 C22 14 26 18 40 20 C26 22 22 26 20 40 C18 26 14 22 0 20 C14 18 18 14 20 0 Z" /></svg>
		<svg class="portal-sparkle portal-sparkle--2" viewBox="0 0 40 40" data-depth="28"><path d="M20 0 C22 14 26 18 40 20 C26 22 22 26 20 40 C18 26 14 22 0 20 C14 18 18 14 20 0 Z" /></svg>
	</div>

	<!-- Little creatures whose eyes follow the mouse -->
	<HeroCreatures />

	<div class="hero-content">
		<p class="home-eyebrow header-eyebrow">
			Hi, I'm Indi Watté, a<!-- the bee (ScrollBird) starts right after this line -->
			<span class="bee-anchor" data-bee-start>
				<!-- What the bee is about: shown while it waits in the hero, gone once it flies -->
				<span class="bee-bubble" data-bee-bubble><span class="bee-bubble-pop">Busy bee at work ☕</span></span>
			</span>
		</p>

		<h1 class="hero-title">
			<span id="hero-line-static" class="hero-line"></span>
			<span id="hero-line-dynamic" class="hero-line hero-line--word">
				<span id="hero-word" class="hero-word"></span>
			</span>
		</h1>

		<MusicPod />
	</div>

	<div class="hero-scroll">Scroll</div>
</section>

<style>
	/* ============ SECTION: GRADIENT SKY + GRAIN ============ */
	.hero {
		position: relative;
		/* not flat: cobalt sky melting into violet, pink and a warm orange horizon,
		   with a soft pink glow behind the portal */
		background:
			radial-gradient(ellipse at 80% 55%, rgba(255, 214, 230, 0.35), transparent 45%),
			radial-gradient(ellipse at 10% 5%, rgba(160, 176, 255, 0.35), transparent 50%),
			linear-gradient(180deg, #3d4fec 0%, #4f5ef0 32%, #8c86f4 60%, #dcaee6 82%, #ffd3c2 100%);
		display: flex;
		align-items: center;
		justify-content: flex-start;
		width: 100%;
		height: 100vh;
		min-height: 640px;
		overflow: hidden;
	}

	.hero-grain {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: var(--grain);
		opacity: 0.3;
		mix-blend-mode: soft-light;
		pointer-events: none;
	}

	/* ============ MIRROR: MY PHOTO IN AN ARCH, FLOATING ON CLOUDS ============ */
	.hero-portal {
		--portal-w: 25vw;
		position: absolute;
		right: 7vw;
		bottom: 17%;
		/* no z-index: its layers interleave with the creatures (frame 3, peeking
		   creatures 4, clouds 5, sparkles 6) */
		width: var(--portal-w);
		aspect-ratio: 5 / 7;
		pointer-events: none;
	}

	.portal-frame {
		position: absolute;
		inset: 0;
		z-index: 3;
		overflow: hidden;
		border: 0.55rem solid var(--home-sun);
		border-radius: 999px 999px 2rem 2rem;
		background: #f3dcf7;
		box-shadow:
			0 0 0 0.35rem rgba(255, 255, 255, 0.35),
			0 30px 60px rgba(23, 21, 58, 0.28);
	}

	.portal-me {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 74% 50%; /* me, on the right of the photo */
		/* zoomed in on me; the frame (overflow: hidden) crops the rest */
		
		transform-origin: 74% 64%;
	}

	/* A soft glow and a touch of grain over the glass */
	.portal-frame::after {
		content: "";
		position: absolute;
		inset: 0;
		background:
			linear-gradient(160deg, rgba(255, 255, 255, 0.28), transparent 40%),
			var(--grain-soft);
		pointer-events: none;
	}

	.portal-clouds {
		position: absolute;
		z-index: 5;
		left: -18%;
		bottom: -12%;
		width: 136%;
		height: auto;
		filter: drop-shadow(0 12px 18px rgba(23, 21, 58, 0.18));
	}

	.portal-sparkle {
		position: absolute;
		z-index: 6;
		fill: #fff;
		filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.9));
		animation: sparkle 2.4s ease-in-out infinite alternate;
	}

	.portal-sparkle--1 {
		top: -4%;
		right: -8%;
		width: 2.6rem;
	}

	.portal-sparkle--2 {
		top: 34%;
		left: -12%;
		width: 1.6rem;
		animation-delay: -1.2s;
	}

	@keyframes sparkle {
		from {
			scale: 0.7;
			rotate: 0deg;
		}
		to {
			scale: 1.1;
			rotate: 45deg;
		}
	}

	/* ============ BUSY BEE SPEECH BUBBLE ============ */
	.bee-anchor {
		position: relative;
		display: inline-block;
	}

	/* Outer: placed + faded on scroll (script); inner: pops in once (CSS) */
	.bee-bubble {
		position: absolute;
		left: 7.5rem;
		bottom: 1.6rem;
	}

	.bee-bubble-pop {
		display: block;
		padding: 0.45rem 0.9rem;
		border-radius: 1rem 1rem 1rem 0.2rem;
		background: #fff;
		color: var(--home-text);
		font-family: var(--body-font);
		font-size: 0.8rem;
		font-weight: 700;
		white-space: nowrap;
		box-shadow: 0 10px 24px rgba(23, 21, 58, 0.2);
		transform-origin: 0 100%;
		animation: bubble-pop 0.6s 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}

	@keyframes bubble-pop {
		from {
			opacity: 0;
			scale: 0.4;
		}
	}

	@media (max-width: 767px) {
		/* Phones: no room on the right, so it sits to the left of the bee, above the intro line */
		.bee-bubble {
			left: auto;
			right: 0.4rem;
			bottom: 1.5rem;
		}

		.bee-bubble-pop {
			font-size: 0.7rem;
			border-radius: 1rem 1rem 0.2rem 1rem;
			transform-origin: 100% 100%;
		}
	}

	/* ============ TEXT ============ */
	.hero-content {
		position: relative;
		z-index: 10;
		display: flex;
		flex-direction: column;
		width: 100%;
		padding-inline: 1.5rem;
		color: #fff;
	}

	/* "Designer who" + the rotating word */
	.hero-title {
		width: 100%;
		margin: 0;
		font-size: clamp(3.2rem, calc(9vw + 1rem), 8rem); /* min (phone), preferred, max (desktop) */
		font-family: var(--title-font);
		font-style: normal;
		font-weight: 100;
		line-height: 0.82; /* cofo-cinema1909 has short capitals for its size */
		letter-spacing: -0.025em;
		text-transform: uppercase;
		user-select: none;
	}

	.hero-line {
		display: block;
		text-align: left;
		white-space: nowrap;
	}

	.hero-line--word {
		margin-top: 0;
		text-align: right;
	}

	.hero-word {
		display: inline-block;
		padding-block: 0.08em; /* room for the spinning word, without a gap */
	}

	/* ============ SCROLL HINT ============ */
	.hero-scroll {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		z-index: 10;
		transform: translateX(-50%);
		font-size: 0.75rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
	}

	/* ============ PHONES: TEXT ON TOP, PORTAL BELOW ============ */
	@media (max-width: 767px) {
		.hero {
			align-items: flex-start;
			padding-top: 7rem;
			box-sizing: border-box;
		}

		.hero-title {
			font-size: clamp(2.6rem, 12.5vw, 3.8rem); /* "Designer who" fits the screen */
		}

		.hero-portal {
			--portal-w: 52vw;
			right: auto;
			left: 50%;
			bottom: 13%;
			translate: -50% 0;
		}
	}

	/* ============ TABLET + DESKTOP: TEXT LEFT, PORTAL RIGHT ============ */
	@media (min-width: 768px) {
		.hero-content {
			width: 54vw;
			margin-left: 6vw;
			padding-inline: 0;
		}

		.hero-title {
			font-size: clamp(4rem, 8.2vw, 9.5rem);
		}

		.hero-line--word {
			margin-top: 0;
		}
	}
</style>

<script>
	import { gsap } from "../../scripts/gsap";

	// Depth: the layers of the mirror drift with the mouse, the closer ones (clouds,
	// sparkles) further than the framed photo behind them.
	function initPortalDepth() {
		const portal = document.querySelector<HTMLElement>("[data-portal]");
		if (!portal || portal.dataset.ready) return;
		if (!window.matchMedia("(hover: hover) and (prefers-reduced-motion: no-preference)").matches) return;
		portal.dataset.ready = "true";

		const layers = [...portal.querySelectorAll<HTMLElement | SVGElement>("[data-depth]")].map((el) => ({
			depth: Number(el.dataset.depth),
			x: gsap.quickTo(el, "x", { duration: 0.8, ease: "power3.out" }),
			y: gsap.quickTo(el, "y", { duration: 0.8, ease: "power3.out" }),
		}));

		window.addEventListener(
			"pointermove",
			(event) => {
				const dx = event.clientX / window.innerWidth - 0.5;
				const dy = event.clientY / window.innerHeight - 0.5;
				for (const layer of layers) {
					layer.x(dx * layer.depth);
					layer.y(dy * layer.depth * 0.6);
				}
			},
			{ passive: true },
		);
	}

	initPortalDepth();

	// The speech bubble fades away as soon as the bee starts flying off (first bit of scroll).
	const bubble = document.querySelector("[data-bee-bubble]");
	if (bubble) {
		gsap.fromTo(bubble, { autoAlpha: 1, y: 0 }, {
			autoAlpha: 0,
			y: -10,
			ease: "none",
			scrollTrigger: { start: 0, end: 120, scrub: true },
		});
	}
</script>
