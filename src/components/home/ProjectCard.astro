---
interface Props {
	/** Projects link to their page; side work (drawings, paintings) has no href. */
	href?: string;
	/** A card shows either an image or a (silent, looping) video. */
	image?: string;
	video?: string;
	/** Still shown until the video plays (and on devices that don't autoplay). */
	poster?: string;
	alt: string;
	title: string;
	desc: string;
}

const { href, image, video, poster, alt, title, desc } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag href={href} class="project-card">
	{
		video ? (
			<video src={video} poster={poster} aria-label={alt} autoplay muted loop playsinline preload="metadata" />
		) : (
			<img src={image} alt={alt} loading="lazy" decoding="async" />
		)
	}
	<div class="project-overlay">
		<div class="project-overlay-content">
			<p class="project-title">{title}</p>
			<p class="project-desc">{desc}</p>
		</div>
	</div>
</Tag>
