---
// Hero background: funny, glossy and fuzzy creatures grouped around my photo (the portal).
// The drawings and the eye tracking are shared (src/components/creatures/); this file only
// places them, and makes them fly up when you scroll.
//  - x/y:   position in the hero (share of its width/height); phoneX/phoneY override them on phones
//  - size:  width on desktop (rem); phone: true also shows it on phones (at 60%),
//           desktop: false hides it on larger screens
//  - peek:  sits in front of my photo but behind the mirror's clouds, peeking out of them
import Creature from "../creatures/Creature.astro";
import type { CreatureName } from "../creatures/art";

interface Placement {
	name: CreatureName;
	x: string;
	y: string;
	phoneX?: string;
	phoneY?: string;
	size: number;
	rotate: number;
	phone?: boolean;
	desktop?: boolean;
	peek?: boolean;
}

// While the mouse rests (and on phones) they look at the title, leading the eye there.
const placements: Placement[] = [
	// on the left side, level with the title
	{ name: "rainbow", x: "11%", y: "34%", phoneX: "4%", phoneY: "60%", size: 7.5, rotate: -10, phone: true },
	{ name: "cyclops", x: "86%", y: "16%", phoneX: "80%", phoneY: "12%", size: 4.5, rotate: 0, phone: true },
	{ name: "cloud", x: "8%", y: "62%", phoneX: "4%", phoneY: "74%", size: 6, rotate: -10, phone: true },
];
---

<div class="creatures" aria-hidden="true" data-hero-creatures>
	{
		placements.map((c, i) => (
			<Creature
				name={c.name}
				index={i}
				class:list={["placed", { "is-desktop-only": !c.phone, "is-phone-only": c.desktop === false, "is-peeking": c.peek }]}
				style={`--x: ${c.x}; --y: ${c.y}; --px: ${c.phoneX ?? c.x}; --py: ${c.phoneY ?? c.y}; --size: ${c.size}rem; --r: ${c.rotate}deg;`}
				data-look-at=".hero-title"
			/>
		))
	}
</div>

<style>
	/* No z-index on the container: each creature slots in between the layers of the mirror
	   (Hero.astro): behind the photo frame (3), or, when peeking, between the frame and the
	   clouds (4). The wavy edge of the next section covers the low ones too. */
	.creatures {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.creatures :global(.placed) {
		position: absolute;
		z-index: 2;
		left: min(var(--x), 100% - var(--size));
		top: var(--y);
		width: var(--size);
		rotate: var(--r);
	}

	.creatures :global(.placed.is-peeking) {
		z-index: 4;
	}

	/* Phones: smaller, and only the creatures marked phone: true */
	@media (max-width: 767px) {
		.creatures :global(.placed) {
			top: var(--py);
			width: calc(var(--size) * 0.6);
			left: min(var(--px), 100% - var(--size) * 0.6);
		}

		.creatures :global(.is-desktop-only) {
			display: none;
		}
	}

	@media (min-width: 768px) {
		.creatures :global(.is-phone-only) {
			display: none;
		}
	}
</style>

<script>
	import { gsap } from "../../scripts/gsap";

	// While the hero is pinned and the next section slides over it (heroScroll.ts), the
	// creatures fly up out of the hero, each at its own speed and with a little spin, so
	// the ones hiding behind the clouds rise out of them first.
	function initCreatureFlight() {
		const creatures = gsap.utils.toArray<SVGSVGElement>("[data-hero-creatures] [data-creature]");
		if (!creatures.length) return;
		gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
			const flight = gsap.timeline({
				scrollTrigger: { trigger: "#hero", start: "top top", end: "+=100%", scrub: 1 },
			});
			creatures.forEach((creature, i) => {
				flight.to(
					creature,
					{
						y: () => -window.innerHeight * gsap.utils.random(0.55, 1.1),
						rotation: gsap.utils.random(-25, 25),
						ease: "power1.in",
						duration: 1,
					},
					(i % 4) * 0.08, // small head starts, so they don't all lift off together
				);
			});
		});
	}

	initCreatureFlight();
</script>
