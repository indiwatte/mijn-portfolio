---
// Homepage work section.
//  1. Case studies: the two strongest projects, built from their own Markdown files
//     (image, one-line summary, my role, tools), so they always match the project page.
//  2. Play: drawings and paintings pegged to the bee's scroll line, which zigzags down
//     through them like a washing line (ropeGallery.ts, drawn by scrollPath.ts).
import { projects } from "../../data/projects";

interface Frontmatter {
	title: string;
	summary?: string;
	role?: string;
	team?: string;
	stack?: string[];
	tags?: string[];
	heroImage?: string;
}

// Which projects lead, in this order
const FEATURED = ["sounds-like-antwerp", "sunrise"];

const pages = import.meta.glob<{ frontmatter: Frontmatter }>(
	"../../pages/projects/*.md",
	{ eager: true },
);
const cases = FEATURED.map((slug) => {
	const page = pages[`../../pages/projects/${slug}.md`];
	if (!page) return undefined;
	const fm = page.frontmatter;
	const href = `/projects/${slug}`;
	return {
		href,
		title: fm.title,
		summary: fm.summary,
		role: fm.role,
		team: fm.team,
		// Tools if filled in, otherwise the project's tags
		pills: fm.stack?.length ? fm.stack : (fm.tags ?? []),
		image:
			fm.heroImage ??
			projects.find((project) => project.href === href)?.image,
	};
}).filter((c) => c !== undefined);

const F = "/images/featured";

// Side work: drawings and paintings (no project page behind them), in the order they
// are hung on the line. w/h = the image's size, so the frame keeps its shape while loading.
const paintings = [
	{
		image: `${F}/octopus.webp`,
		w: 1000,
		h: 1161,
		alt: "Painting an octopus on an iPad with a stylus",
		title: "Octopus",
		desc: "Digital painting",
	},
	{
		image: `${F}/collage.webp`,
		w: 792,
		h: 992,
		alt: "Collage of a woman with a crown of flowers over her eyes",
		title: "Flower crown",
		desc: "Collage",
	},
	{
		image: `${F}/painted-portrait.webp`,
		w: 886,
		h: 886,
		alt: "Indi next to her large, colourful painted portrait",
		title: "Painted portrait",
		desc: "Painting",
	},
	{
		image: `${F}/illustration1.webp`,
		w: 769,
		h: 1020,
		alt: "Colourful line drawing of a crying face",
		title: "Face study",
		desc: "Digital drawing",
	},
	{
		image: `${F}/headwrap-portrait.webp`,
		w: 1000,
		h: 1000,
		alt: "Painting of a woman in a colourful headwrap, hanging on a wall",
		title: "Headwrap portrait",
		desc: "Painting",
	},
	{
		image: `${F}/papegaai.webp`,
		w: 900,
		h: 1157,
		alt: "Digital painting of a green parrot",
		title: "Parrot",
		desc: "Digital painting",
	},
	{
		image: `${F}/illustration2.webp`,
		w: 752,
		h: 1044,
		alt: "Illustrated figure in red, purple and gold lines",
		title: "Red figure",
		desc: "Digital illustration",
	},
];

// Clothes pegs in the site's colours, one after the other
const PEGS = ["#ff8fb1", "#ffc93c", "#5868f0", "#c9a7f0"];
---

<!-- data-footer-overlap: this section stays pinned while the footer slides over it -->
<section id="work" class="home-work" data-footer-overlap>
	<div class="home-work-header" data-cursor-arrow>
		<div class="home-work-heading">
			<h2>Selected case studies</h2>
		</div>
		<a href="/projects" class="all-link">All projects →</a>
	</div>

	<!-- ============ CASE STUDIES ============ -->
	<div class="cases" data-cursor-arrow>
		{
			cases.map((c) => (
				<a href={c.href} class="case">
					<div class="case-media">
						<img
							src={c.image}
							alt={`${c.title}: project image`}
							loading="lazy"
							decoding="async"
						/>
						<ul
							class="tag-pills case-pills"
							aria-label="Tools and tags"
						>
							{c.pills.map((pill) => (
								<li>{pill}</li>
							))}
						</ul>
					</div>
					<div class="case-info">
						<h3 class="case-title">
							{c.title} <span aria-hidden="true">→</span>
						</h3>
						{c.summary && <p class="case-summary">{c.summary}</p>}
						{c.role && (
							<p class="case-role">
								<span>My role</span> {c.role}
								{c.team && ` · ${c.team}`}
							</p>
						)}
					</div>
				</a>
			))
		}
	</div>

	<!-- ============ PLAY: DRAWINGS & PAINTINGS ============ -->
	<div class="play-wall">
		<div class="play-header">
			<h3>some other stuff</h3>
			<p>
				Where it all started: I still draw and paint next to my design
				work.
			</p>
		</div>

		<!-- Without JS the paintings sit in a simple grid; ropeGallery.ts strings them up -->
		<div class="rope-gallery" data-rope-gallery>
			<!-- Same thin striped line as the bee's (ScrollPath.astro). It's drawn by pulling back
		     a cover stroke (scrollPath.ts); here the cover is a mask, so it works on any background -->
			<svg class="rope" aria-hidden="true">
				<defs>
					<mask
						id="rope-reveal"
						maskUnits="userSpaceOnUse"
						x="-2000"
						y="-4000"
						width="8000"
						height="16000"
					>
						<rect
							x="-2000"
							y="-4000"
							width="8000"
							height="16000"
							fill="#fff"></rect>
						<path class="rope-cover" data-cover></path>
					</mask>
				</defs>
				<path class="rope-line" data-line mask="url(#rope-reveal)"
				></path>
			</svg>

			<ul class="rope-items">
				{
					paintings.map((p, i) => (
						<li class="hang" data-hang>
							<div class="hang-drop" data-hang-drop>
								<div
									class="hang-sway"
									style={`--sway-time: ${3.2 + (i % 3) * 0.7}s; --sway-delay: -${i * 0.9}s`}
								>
									<svg
										class="hang-peg"
										viewBox="0 0 14 40"
										style={`--peg: ${PEGS[i % PEGS.length]}`}
										aria-hidden="true"
									>
										<rect
											x="0.5"
											y="0"
											width="6"
											height="40"
											rx="3"
										/>
										<rect
											x="7.5"
											y="0"
											width="6"
											height="40"
											rx="3"
										/>
										<rect
											class="hang-peg-spring"
											x="0"
											y="15"
											width="14"
											height="5"
											rx="2"
										/>
									</svg>
									<figure class="hang-frame">
										<span class="hang-art">
											<img
												src={p.image}
												width={p.w}
												height={p.h}
												alt={p.alt}
												loading="lazy"
												decoding="async"
											/>
										</span>
										<figcaption>
											{p.title} <span>· {p.desc}</span>
										</figcaption>
									</figure>
								</div>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.all-link {
		font-weight: 600;
		color: var(--home-text);
		text-decoration: none;
	}

	.all-link:hover {
		color: var(--home-sun);
	}

	/* ============ CASE STUDIES ============ */
	.cases {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
	}

	/* Side by side; the one you hover spreads out sideways and the other makes room */
	@media (min-width: 768px) {
		.cases {
			display: flex;
			align-items: flex-start;
		}

		.case {
			flex: 1 1 0;
			min-width: 0;
			transition: flex-grow 700ms cubic-bezier(0.22, 1, 0.36, 1);
		}

		.case:hover,
		.case:focus-visible {
			flex-grow: 1.6;
		}

		/* fixed height, so spreading only adds width (and shows more of the image) */
		.cases .case-media {
			aspect-ratio: auto;
			height: clamp(16rem, 28vw, 26rem);
		}
	}

	/* Plain rectangles. The white background keeps them solid while they're stacked as a
	   deck (projectsGallery.ts); on the white page it doesn't show. */
	.case {
		display: block;
		background: var(--home-surface);
		color: var(--home-text);
		text-decoration: none;
	}

	.case-media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 4 / 3;
		background: #ece4f6;
	}

	.case:nth-child(2) .case-media {
		background: #ffe8d2;
	}

	.case-media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.case-info {
		padding-top: 1rem;
	}

	.case-title {
		margin: 0;
		font-family: var(--heading-font);
		font-size: clamp(1.6rem, 2.4vw, 2.1rem);
		font-weight: 400;
		letter-spacing: 0;
		text-transform: uppercase;
	}

	.case-title span {
		display: inline-block;
		color: var(--home-accent);
		transition: translate 300ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.case:hover .case-title span {
		translate: 0.3rem 0;
	}

	.case-summary {
		margin: 0.4rem 0 0;
		line-height: 1.55;
		color: var(--home-muted);
	}

	.case-role {
		margin: 0.5rem 0 0;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.case-role span {
		margin-right: 0.3rem;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--home-muted);
	}

	/* Tags on the photo, flush in the top left corner */
	.case-pills {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		gap: 0.3rem;
	}

	/* Solid tabs with a slanted right edge: white on cobalt (7:1), readable on any photo */
	.case-pills li {
		padding: 0.45rem 1.4rem 0.45rem 0.85rem;
		border-radius: 0;
		background: #2a3be8;
		color: #fff;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		clip-path: polygon(0 0, 100% 0, calc(100% - 0.75rem) 100%, 0 100%);
	}

	.case:focus-visible {
		outline: 3px solid var(--home-blue);
		outline-offset: 6px;
	}

	/* ============ PLAY ============ */
	.play-header {
		margin: clamp(4rem, 9vw, 7rem) 0 clamp(1.5rem, 3vw, 2.25rem);
	}

	.play-header h3 {
		margin: 0;
		font-family: var(--heading-font);
		font-size: clamp(1.8rem, 3.2vw, 2.6rem);
		font-weight: 400;
		text-transform: uppercase;
		color: var(--home-text);
	}

	.play-header p {
		margin: 0.4rem 0 0;
		color: var(--home-muted);
	}

	/* ============ PLAY ============ */
	.play-wall {
		margin-top: clamp(3rem, 7vw, 5rem);
	}

	.play-wall .play-header {
		/* no extra space above the title */
		margin-top: 0;
	}

	/* ============ ROPE GALLERY ============ */
	.rope-gallery {
		position: relative;
	}

	.rope {
		position: absolute;
		inset: 0;
		z-index: -1; /* behind the headings and case studies it runs past */
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

	.rope path {
		fill: none;
	}

	/* Same look as the bee's line (ScrollPath.astro) */
	.rope-line {
		stroke: var(--home-text);
		stroke-width: 1.5;
		stroke-dasharray: 6 8;
		stroke-linecap: round;
		opacity: 0.35;
	}

	/* in the mask: black hides the line where it isn't drawn yet */
	.rope-cover {
		fill: none;
		stroke: #000;
		stroke-width: 8;
	}

	/* Fallback (no JS): a plain grid */
	.rope-items {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
		gap: 2rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.rope-gallery.is-strung .rope-items {
		display: block;
	}

	.rope-gallery.is-strung .hang {
		position: absolute;
		/* left, top, width and --tilt come from ropeGallery.ts */
		rotate: var(--tilt, 0deg);
		transform-origin: 50% 0;
	}

	.hang-drop,
	.hang-sway {
		transform-origin: 50% 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		.rope-gallery.is-strung .hang-sway {
			animation: hang-sway var(--sway-time) ease-in-out var(--sway-delay)
				infinite alternate;
		}
	}

	@keyframes hang-sway {
		from {
			rotate: -1.8deg;
		}
		to {
			rotate: 1.8deg;
		}
	}

	/* the peg clamps the line just above the frame */
	.hang-peg {
		position: absolute;
		top: -1.55rem;
		left: 50%;
		z-index: 1;
		width: 0.85rem;
		translate: -50% 0;
		fill: var(--peg);
		filter: drop-shadow(0 2px 2px rgba(23, 21, 58, 0.2));
	}

	.hang-peg-spring {
		fill: #9aa0ad;
	}

	.rope-gallery:not(.is-strung) .hang-peg {
		display: none;
	}

	/* The painting itself, unframed, with a soft shadow; its title underneath */
	.hang-frame {
		margin: 0;
	}

	.hang-art {
		display: block;
		filter: drop-shadow(0 14px 18px rgba(40, 25, 10, 0.3));
	}

	.hang-art img {
		display: block;
		width: 100%;
		height: auto;
	}

	.hang-frame figcaption {
		width: fit-content;
		max-width: 92%;
		margin: 0.7rem auto 0;
		font-family: var(--body-font);
		font-size: clamp(0.62rem, 0.75vw, 0.72rem);
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: 0.04em;
		text-align: center;
		color: var(--home-text);
	}

	.hang-frame figcaption span {
		font-weight: 400;
		color: var(--home-muted);
	}
</style>
