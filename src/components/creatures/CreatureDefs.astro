---
// Gradients and the fur filter used by every creature (src/components/creatures/art.ts).
// Rendered once per page by BaseLayout. Not display:none, or some browsers skip them.
---

<svg class="creature-defs" width="0" height="0" aria-hidden="true">
	<defs>
		<radialGradient id="cr-orange" cx="35%" cy="30%" r="80%">
			<stop offset="0" stop-color="#ffd2b8" /><stop offset=".5" stop-color="#ff6a3d" /><stop offset="1" stop-color="#d6360c" />
		</radialGradient>
		<radialGradient id="cr-pink" cx="35%" cy="30%" r="80%">
			<stop offset="0" stop-color="#ffe3f6" /><stop offset=".5" stop-color="#ffa6e6" /><stop offset="1" stop-color="#e04fb4" />
		</radialGradient>
		<radialGradient id="cr-butter" cx="35%" cy="30%" r="80%">
			<stop offset="0" stop-color="#fff6d6" /><stop offset=".5" stop-color="#f5dc9a" /><stop offset="1" stop-color="#e9a24e" />
		</radialGradient>
		<radialGradient id="cr-peach" cx="35%" cy="30%" r="80%">
			<stop offset="0" stop-color="#fff7f0" /><stop offset=".5" stop-color="#f6d7c3" /><stop offset="1" stop-color="#f08f78" />
		</radialGradient>
		<radialGradient id="cr-petal" cx="40%" cy="35%" r="70%">
			<stop offset="0" stop-color="#fff7f0" /><stop offset=".55" stop-color="#ffa6e6" /><stop offset="1" stop-color="#ff9a6b" />
		</radialGradient>
		<radialGradient id="cr-slime" cx="35%" cy="40%" r="75%">
			<stop offset="0" stop-color="#ffffff" /><stop offset=".45" stop-color="#f3d1f7" /><stop offset="1" stop-color="#c77ce0" />
		</radialGradient>
		<linearGradient id="cr-worm" x1="0" y1="0" x2="1" y2="1">
			<stop offset="0" stop-color="#ffa6e6" /><stop offset=".5" stop-color="#ff9a6b" /><stop offset="1" stop-color="#f5dc9a" />
		</linearGradient>
		<radialGradient id="cr-pupil" cx="40%" cy="35%" r="70%">
			<stop offset="0" stop-color="#5a3040" /><stop offset="1" stop-color="#0a0004" />
		</radialGradient>
		<!-- Fur: shakes the edges of a shape with fine noise -->
		<filter id="cr-fur" x="-15%" y="-15%" width="130%" height="130%">
			<feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="4" result="noise" />
			<feDisplacementMap in="SourceGraphic" in2="noise" scale="7" xChannelSelector="R" yChannelSelector="G" />
		</filter>
	</defs>
</svg>

<style>
	.creature-defs {
		position: absolute;
		pointer-events: none;
	}
</style>
