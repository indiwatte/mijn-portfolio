---
// Loading screen (like vogue.com): my face bobbing above "Loading..." until the page,
// its images and fonts are in, then it slides away. On every full page load and reload.
// Styles and script are inline so the screen is there from the very first paint.
---

<div class="loader" data-loader role="status" aria-live="polite">
	<div class="loader-face">
		<img src="/images/face-loader.jpg" width="410" height="520" alt="" fetchpriority="high" />
		<span class="loader-shadow" aria-hidden="true"></span>
	</div>
	<p class="loader-text">
		Loading<span aria-hidden="true"><i>.</i><i>.</i><i>.</i></span>
	</p>
</div>

<script is:inline>
	(() => {
		const loader = document.querySelector("[data-loader]");
		if (!loader) return;
		const root = document.documentElement;
		root.style.overflow = "hidden";
		const started = performance.now();
		const MIN = 1100; // long enough to see the face, short enough not to annoy
		const MAX = 8000; // never keep someone waiting on one slow image

		const pageLoaded = new Promise((resolve) => {
			if (document.readyState === "complete") resolve();
			else window.addEventListener("load", resolve, { once: true });
		});
		const fontsLoaded = document.fonts ? document.fonts.ready : Promise.resolve();

		let done = false;
		const finish = () => {
			if (done) return;
			done = true;
			const wait = Math.max(0, MIN - (performance.now() - started));
			setTimeout(() => {
				loader.classList.add("is-done");
				root.style.overflow = "";
				// "transitionend" can be skipped (hidden tab), so remove on a timer too.
				setTimeout(() => loader.remove(), 1000);
			}, wait);
		};

		Promise.all([pageLoaded, fontsLoaded]).then(finish);
		setTimeout(finish, MAX);
	})();

	// Client-side navigation (project pages) isn't a reload: no loader in between.
	document.addEventListener("astro:before-swap", (event) => {
		event.newDocument.querySelector("[data-loader]")?.remove();
	});
</script>

<style is:inline>
	.loader {
		position: fixed;
		inset: 0;
		z-index: 90; /* above the header and menu; the custom cursor stays on top */
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1.6rem;
		background: #fff;
		color: #17153a;
		transition: transform 800ms cubic-bezier(0.76, 0, 0.24, 1);
	}

	/* Leaving: the face hops up, then the whole screen slides up like a curtain */
	.loader.is-done {
		transform: translateY(-100%);
		transition-delay: 250ms;
		pointer-events: none;
	}

	.loader-face {
		position: relative;
		width: clamp(7.5rem, 22vw, 10rem);
	}

	.loader-face img {
		display: block;
		width: 100%;
		height: auto;
		mix-blend-mode: multiply; /* the photo's white background melts into the page */
		transform-origin: 50% 90%;
		animation: loader-bob 1.1s cubic-bezier(0.45, 0, 0.55, 1) infinite;
	}

	.loader.is-done .loader-face img {
		animation: loader-hop 450ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
	}

	.loader-shadow {
		position: absolute;
		left: 50%;
		bottom: -0.9rem;
		width: 60%;
		height: 0.7rem;
		border-radius: 50%;
		background: rgba(23, 21, 58, 0.12);
		translate: -50% 0;
		animation: loader-shadow 1.1s cubic-bezier(0.45, 0, 0.55, 1) infinite;
	}

	.loader-text {
		margin: 0;
		font-family: "Poppins", system-ui, sans-serif;
		font-size: clamp(1.8rem, 5vw, 2.6rem);
		font-weight: 400;
		letter-spacing: -0.01em;
	}

	/* the dots appear one by one, then start over together */
	.loader-text i {
		font-style: normal;
		animation: loader-dot-1 1.4s steps(1) infinite;
	}

	.loader-text i:nth-child(2) {
		animation-name: loader-dot-2;
	}

	.loader-text i:nth-child(3) {
		animation-name: loader-dot-3;
	}

	/* a happy little bounce, tilting from side to side */
	@keyframes loader-bob {
		0%,
		100% {
			transform: translateY(0) rotate(-6deg) scale(1, 1);
		}
		45% {
			transform: translateY(-18%) rotate(5deg) scale(0.98, 1.02);
		}
		90% {
			transform: translateY(0) rotate(-6deg) scale(1.04, 0.96);
		}
	}

	@keyframes loader-shadow {
		0%,
		100% {
			transform: scaleX(1);
			opacity: 1;
		}
		45% {
			transform: scaleX(0.65);
			opacity: 0.5;
		}
	}

	@keyframes loader-hop {
		to {
			transform: translateY(-30%) rotate(0deg) scale(1.08);
		}
	}

	@keyframes loader-dot-1 {
		0% { opacity: 0; }
		25% { opacity: 1; }
	}

	@keyframes loader-dot-2 {
		0% { opacity: 0; }
		50% { opacity: 1; }
	}

	@keyframes loader-dot-3 {
		0% { opacity: 0; }
		75% { opacity: 1; }
	}

	@media (prefers-reduced-motion: reduce) {
		.loader,
		.loader.is-done {
			transition: opacity 400ms ease;
			transform: none;
		}

		.loader.is-done {
			opacity: 0;
		}

		.loader-face img,
		.loader-shadow,
		.loader-text i,
		.loader.is-done .loader-face img {
			animation: none;
		}
	}
</style>
