---
// My resume: a "View resume" button with a preview of the first page under it. Both open
// the resume page (/resume), where the PDF fills the screen. Used on the About page and in
// the homepage footer.
// To update: replace public/files/resume.pdf, then re-export resume-preview.webp next to it.
interface Props {
	/** "light" on pale backgrounds, "dark" on the blue footer. */
	tone?: "light" | "dark";
	/** Width of the preview. */
	size?: string;
}

const { tone = "light", size = "18rem" } = Astro.props;
const RESUME_PAGE = "/resume";
---

<div class:list={["resume", `resume--${tone}`]} style={`--resume-w: ${size}`}>
	<a href={RESUME_PAGE} class="resume-download">
		View resume <span aria-hidden="true">→</span>
	</a>
	<a href={RESUME_PAGE} class="resume-preview" tabindex="-1" aria-hidden="true">
		<img
			src="/files/resume-preview.webp"
			width="900"
			height="1274"
			alt=""
			loading="lazy"
			decoding="async"
		/>
	</a>
</div>

<style>
	.resume {
		display: grid;
		grid-template-columns: minmax(0, 1fr); /* the preview is exactly the card's width */
		justify-items: start;
		gap: 1rem;
		/* a fixed width: a percentage would let the loaded image (900px) widen its column */
		width: var(--resume-w);
		max-width: 100%;
	}

	.resume-download {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.4rem;
		border-radius: 999px;
		background: var(--home-blue);
		color: #fff;
		font-size: 0.9rem;
		font-weight: 600;
		white-space: nowrap;
		text-decoration: none;
		transition:
			background 200ms ease,
			transform 200ms ease;
	}

	.resume-download span {
		transition: translate 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.resume-download:hover {
		background: var(--home-text);
	}

	.resume-download:hover span {
		translate: 0.2rem 0;
	}

	.resume--dark .resume-download {
		padding: 0.65rem 1.1rem;
		font-size: 0.8rem;
		background: var(--home-sun);
		color: var(--home-ink);
	}

	.resume--dark .resume-download:hover {
		background: #fff;
	}

	/* The page itself, like a sheet of paper lying slightly crooked */
	.resume-preview {
		display: block;
		width: 100%;
		rotate: -2deg;
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.1),
			0 16px 36px rgba(23, 21, 58, 0.22);
		transition:
			rotate 400ms cubic-bezier(0.34, 1.56, 0.64, 1),
			scale 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.resume-preview:hover {
		rotate: 0deg;
		scale: 1.03;
	}

	.resume-preview img {
		display: block;
		width: 100%;
		height: auto;
	}

	.resume a:focus-visible {
		outline: 3px solid var(--home-sun);
		outline-offset: 4px;
	}

	@media (prefers-reduced-motion: reduce) {
		.resume-preview,
		.resume-download span {
			transition: none;
		}
	}
</style>
